{
  "name": "calisthenics-tree",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "eye": "tsx eye/eye.ts",
    "mocap": "tsx tools/mocap/cli.ts",
    "mocap:all": "tsx tools/mocap/batch.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
